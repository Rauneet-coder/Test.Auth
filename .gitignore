# ============================================================
# Root .gitignore — covers both backend/ and frontend/ workspaces
# ============================================================

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# ---- Backend ----
backend/node_modules/
backend/.env
backend/.env.*
!backend/.env.example
backend/build/

# ---- Frontend ----
frontend/node_modules/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/dist/

# ---- Root ----
.env
.env.*
*.env
node_modules/

